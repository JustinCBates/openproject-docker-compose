#####Everything up to here is good
echo
echo "Deployment Options:"
echo "=================="
echo "1. Start OpenProject (build and run)"
echo "2. Stop OpenProject"
echo "3. View logs"
echo "4. Restart OpenProject"
echo "5. Update to latest images"
echo "6. Exit"
echo

while true; do
    read -p "Select an option (1-6): " choice
    case $choice in
        1)
            echo "Starting OpenProject..."
            docker compose up -d --build --pull always
            echo
            echo "OpenProject is starting up!"
            echo "You can access it at: http://$host_name"
            if [ "$use_https" = "true" ]; then
                echo "Or via HTTPS at: https://$host_name"
            fi
            echo
            echo "Default login credentials:"
            echo "Username: admin"
            echo "Password: admin"
            echo
            echo "Please change the default password after first login!"
            break
            ;;
        2)
            echo "Stopping OpenProject..."
            docker compose down
            echo "OpenProject stopped."
            break
            ;;
        3)
            echo "Showing recent logs (press Ctrl+C to exit):"
            docker compose logs -f --tail=50
            ;;
        4)
            echo "Restarting OpenProject..."
            docker compose restart
            echo "OpenProject restarted."
            ;;
        5)
            echo "Updating to latest images..."
            docker compose pull
            docker compose up -d
            echo "Update complete."
            ;;
        6)
            echo "Exiting..."
            exit 0
            ;;
        *)
            echo "Invalid option. Please select 1-6."
            ;;
    esac
    echo
done


