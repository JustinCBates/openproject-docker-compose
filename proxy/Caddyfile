${DOMAIN_NAME:-:80} {
    # HANDLE_PATH block will be substituted by configure_proxy.sh if a relative root is configured.
    ${HANDLE_PATH_BLOCK}

    # Default reverse proxy (used when no HANDLE_PATH is configured)
    reverse_proxy * ${APP_HOST}:8080 {
        # Forward explicit X-Forwarded-* headers so upstream apps can know the original request
        header_up X-Forwarded-Proto {header.X-Forwarded-Proto}
        header_up X-Forwarded-For {header.X-Forwarded-For}
        header_up Host {host}
    }

    file_server
    log
},