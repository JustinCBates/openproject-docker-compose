{{/*
  Caddyfile template rendered by gomplate. Runtime values are read from environment
  variables; render with the renderer script in scripts/deploy/render_caddy.sh
*/}}

:80 {
    # Redirect all HTTP to HTTPS (Caddy will handle redirect target)
    redir https://{host}{uri} 308
}

{{ $host := getenv "OPENPROJECT_HOST_NAME" | default "localhost" }}
{{ $rel := getenv "RAILS_RELATIVE_URL_ROOT" | default "/StatesmenProjects" }}

:443 {{ $host }} {
    tls {
        ca https://acme-staging-v02.api.letsencrypt.org/directory
    }

    @openproject path {{ $rel }}*
    handle @openproject {
        reverse_proxy web:8080 {
            header_up X-Forwarded-Proto {http.request.scheme}
            header_up X-Forwarded-For {remote}
            header_up Host {http.request.host}
        }
    }

    file_server
    log
}
