{{/*
  Caddyfile template rendered by gomplate. Runtime values are read from environment
  variables; render with the renderer script in scripts/deploy/render_caddy.sh

  Supported env variables:
    - OPENPROJECT_HOST_NAME / OPENPROJECT_HOST__NAME (host)
    - RAILS_RELATIVE_URL_ROOT (path prefix; default "/")
    - PROXY_HTTP_PORT (default 80)
    - PROXY_HTTPS_PORT (default 443)
    - PROXY_TLS_MODE (internal|letsencrypt_staging|letsencrypt_prod|acme_duckdns)
    - PROXY_HTTPS_REDIRECT (if "false", disables auto_https redirect behavior)
    - APP_HOST (upstream host, default "web")
*/}}

{{/* Helper defaults */}}
{{ $host := getenv "OPENPROJECT_HOST_NAME" | default (getenv "OPENPROJECT_HOST__NAME" | default "localhost") }}
{{ $rel := getenv "RAILS_RELATIVE_URL_ROOT" | default "/" }}
{{ $http := getenv "PROXY_HTTP_PORT" | default "80" }}
{{ $https := getenv "PROXY_HTTPS_PORT" | default "443" }}
{{ $tls := getenv "PROXY_TLS_MODE" | default "internal" }}
{{ $no_redirect := getenv "PROXY_HTTPS_REDIRECT" | default "" }}
{{ $upstream := getenv "APP_HOST" | default "web" }}

{{/* Global option: disable HTTP->HTTPS redirect if explicitly set to false */}}
{{ if eq $no_redirect "false" }}
{
    auto_https disable_redirects
}
{{ end }}

{{/* HTTP site always redirects to HTTPS (Caddy will handle the target) */}}
:80 {
    redir https://{host}{uri} 308
}

{{/* Compose HTTPS site header: include host if provided to avoid ambiguous automation */}}

:{{ $https }}{{ if ne $host "" }} {{ $host }}{{ end }} {

    {{ /* TLS block selection */ }}
    {{ if eq $tls "internal" }}
    tls internal
    {{ else if eq $tls "letsencrypt_staging" }}
    tls {
        ca https://acme-staging-v02.api.letsencrypt.org/directory
    }
    {{ else if eq $tls "acme_duckdns" }}
    tls /etc/caddy/certs/{{ $host }}.fullchain.pem /etc/caddy/certs/{{ $host }}.key
    {{ else }}
    {{ /* letsencrypt_prod or unknown: default Caddy behavior (no explicit tls block) */ }}
    {{ end }}

    {{/* If relroot is not root, proxy only matching paths and preserve the path */}}
    {{ if and (ne $rel "") (ne $rel "/") }}
    @openproject path {{ $rel }}*
    handle @openproject {
        reverse_proxy {{ $upstream }}:8080 {
            header_up X-Forwarded-Proto {http.request.scheme}
            header_up X-Forwarded-For {remote}
            header_up Host {http.request.host}
        }
    }
    {{ else }}
    reverse_proxy * {{ $upstream }}:8080 {
        header_up X-Forwarded-Proto {http.request.scheme}
        header_up X-Forwarded-For {remote}
        header_up Host {http.request.host}
    }
    {{ end }}

    file_server
    log
}
