:80 {
    # Redirect root to the mounted application path
    @root {
        path /
    }
    redir @root /StatesmenProjects 302

    # Serve the OpenProject app under the /StatesmenProjects prefix.
    # Use handle (not handle_path) so the prefix is preserved when proxying.
    # OpenProject is configured with OPENPROJECT_RAILS__RELATIVE__URL__ROOT and
    # expects requests to include the '/StatesmenProjects' prefix.
    handle /StatesmenProjects* {
        reverse_proxy http://${APP_HOST}:8080 {
            # Forward common proxy headers so the app sees original request info
            header_up X-Forwarded-Proto {header.X-Forwarded-Proto}
            header_up X-Forwarded-For {header.X-Forwarded-For}
            # Forward Host header to the upstream so the app receives the original request host
            header_up Host {host}
        }
    }

    file_server

    log
}
